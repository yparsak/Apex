<%- include('partials/head', { title: branch.branch_name, user: user }) %>
  <aside class="sidebar">
    <%- include('partials/branch-sidebar', { repo: repo, branches: branches }) %>
  </aside>
  <main class="content">
    <p><a href="/repos/<%= repo.id %>"><%= repo.name %></a></p>
    <h1><%= branch.branch_name %></h1>
    <p>CO <%= branch.co_number %></p>
    <%# Phase 27. Everything below that *starts* something is hidden under
        read_only/disabled: the clarification form, Approve & Implement, the
        overlap resolution buttons and the failure-recovery actions. The
        conversation, requirements, stepper and logs all stay - the page is
        still the record of what happened here, which is the point of never
        hiding a repo. %>
    <%- include('partials/repo-state-banner', { repo: repo }) %>

    <%# Phase 31: data-top-stepper / data-sub-stepper are the poller's write
        targets (public/js/branch-poll.js). Both are fully rendered
        server-side; the script only ever replaces their <li>s, so with
        JavaScript off this is exactly the page it has always been. %>
    <ol class="stepper" data-top-stepper>
      <% topStepper.forEach(function(s) { %>
        <li class="step step-<%= s.state %>"><%= s.label %></li>
      <% }) %>
    </ol>

    <% if (lockHeld) { %>
      <p class="lock-ok">You hold the pipeline lock for this CO on this repo.</p>
      <%# Phase 29. The abandon verb, and not the same thing as "Clear & start
          new session" further down a failed session's page: that one releases
          and re-acquires so you keep the slot with a fresh session, this one
          leaves the slot free and you holding nothing. Hidden while a run is in
          flight (eligibleForRelease), and under read_only/disabled like every
          other control here that changes something. %>
      <% if (eligibleForRelease && repo.access_state === 'enabled') { %>
        <form method="POST" action="/repos/<%= repo.id %>/branches/<%= branch.id %>/release-lock" class="lock-release-form"
          onsubmit="return confirm('Release the pipeline lock for CO <%= branch.co_number %>? This frees the slot for anyone on this repo and nothing holds it for you — if a colleague starts a session on this CO first, you will not be able to run this one until they finish. This session stays readable but stops being actionable.')">
          <button type="submit" class="danger-button">Release pipeline lock</button>
        </form>
      <% } %>
    <% } else { %>
      <p class="lock-warn">This CO is currently locked by another in-progress session on this repo — a new AI run can't start until that finishes.</p>
    <% } %>
    <% if (error) { %><p class="error"><%= error %></p><% } %>

    <% if (requirements.length) { %>
      <h2>Requirements</h2>
      <ul class="requirement-list">
        <% requirements.forEach(function(r) { %>
          <li class="requirement-item requirement-<%= r.confirm_status %>">
            <span class="requirement-status"><%= r.confirm_status.replace('_', ' ') %></span>
            <span class="requirement-text"><%= r.requirement_text %></span>
          </li>
        <% }) %>
      </ul>
    <% } %>

    <% if (pendingRequirement) { %>
      <div class="overlap-banner">
        <p>
          <strong>Possible overlap detected.</strong> This requirement may already be
          implemented on this branch<% if (overlapRequirement) { %>, matching a previously
          confirmed requirement:<% } else { %>.<% } %>
        </p>
        <p class="requirement-text"><%= pendingRequirement.requirement_text %></p>
        <% if (overlapRequirement) { %>
          <p class="placeholder">Matches: "<%= overlapRequirement.requirement_text %>"</p>
        <% } %>
        <% if (repo.access_state === 'enabled') { %>
          <div class="overlap-actions">
            <form method="POST" action="/repos/<%= repo.id %>/branches/<%= branch.id %>/requirements/<%= pendingRequirement.id %>/confirm" class="inline-form">
              <button type="submit">Confirm &amp; proceed anyway</button>
            </form>
            <form method="POST" action="/repos/<%= repo.id %>/branches/<%= branch.id %>/requirements/<%= pendingRequirement.id %>/skip" class="inline-form">
              <button type="submit" class="danger-button">Skip — already done</button>
            </form>
          </div>
        <% } %>
      </div>
    <% } %>

    <h2>Clarification</h2>
    <div class="conversation">
      <% if (!conversation.length) { %>
        <p class="placeholder">Describe what you need built for this CO to start the clarification loop.</p>
      <% } %>
      <% conversation.forEach(function(m) { %>
        <div class="message message-<%= m.role %>">
          <div class="message-role"><%= m.role === 'user' ? user.username : 'Apex' %></div>
          <div class="message-text"><%= m.content %></div>
        </div>
      <% }) %>
    </div>

    <%# Under read_only/disabled there is no form and no second explanation
        either - the banner at the top of the page is the explanation, and the
        note with it is the admin's. %>
    <% if (repo.access_state === 'enabled' && (session.status === 'awaiting_approval' || session.status === 'queued')) { %>
      <% if (!pendingRequirement) { %>
        <form method="POST" action="/repos/<%= repo.id %>/branches/<%= branch.id %>/messages" class="stacked-form">
          <label><%= conversation.length ? 'Your answer' : 'What do you need built?' %>
            <textarea name="text" rows="4" required></textarea>
          </label>
          <button type="submit">Send</button>
        </form>
      <% } else { %>
        <p class="placeholder">Resolve the overlap above before continuing the clarification loop.</p>
      <% } %>
    <% } %>

    <% if (eligibleForApproval && repo.access_state === 'enabled') { %>
      <h2>Approve &amp; Implement</h2>
      <p class="placeholder">Ready to implement in an isolated sandbox: clone, codegen, build, test, then push to <%= branch.branch_name %>.</p>
      <form method="POST" action="/repos/<%= repo.id %>/branches/<%= branch.id %>/approve">
        <button type="submit">Approve &amp; Implement</button>
      </form>
    <% } %>

    <%# On-demand document runs (see ROADMAP.md Phase 25). Absent entirely -
        not disabled and greyed - when the repo has the feature off or no
        document is active, because a control a user can see but never use
        invites a support ticket the admin has already answered by turning it
        off. runnableDocuments is empty in both cases. %>
    <% if (runnableDocuments.length) { %>
      <h2>Run a document against this branch</h2>
      <p class="placeholder">
        Runs one of the documents an administrator has defined against this branch's code,
        including everything it changes compared to <%= repo.default_branch_name %> — before the merge,
        rather than the night after. Takes about a minute, and the report is shown once:
        it is not saved, and it does not affect the repo's nightly documents.
      </p>
      <form method="POST" action="/repos/<%= repo.id %>/branches/<%= branch.id %>/document-run" class="stacked-form">
        <label>Document
          <select name="doc_key" required>
            <% runnableDocuments.forEach(function(d) { %>
              <option value="<%= d.doc_key %>"><%= d.title %></option>
            <% }) %>
          </select>
        </label>
        <button type="submit">Run against this branch</button>
      </form>
    <% } %>

    <% if (session.status !== 'awaiting_approval') { %>
      <h2>Pipeline</h2>
      <p class="pipeline-status pipeline-<%= session.status %>" data-pipeline-status>Status: <%= session.status %></p>

      <%# Phase 31. The indicator renders in its OFF state and the script
          turns it on, never the other way round: with JavaScript blocked or
          broken, a page that claims to be watching is worse than one that
          admits it is a snapshot, because it turns a stale page into a stale
          page the user trusts. %>
      <% if (progress.live) { %>
        <p class="poll-indicator poll-idle" data-poll-indicator aria-live="polite">
          <span class="poll-dot" aria-hidden="true"></span>
          <span data-poll-text>Live updates are off — refresh this page to see progress.</span>
        </p>
      <% } %>

      <% if (progress.elapsedLabel) { %>
        <p class="pipeline-elapsed" data-pipeline-elapsed><%= session.status === 'queued' ? 'Queued for' : 'Running for' %> <%= progress.elapsedLabel %></p>
      <% } %>

      <%# Rendered empty and hidden when nothing is stalled so the poller has
          somewhere to put the message without building DOM. %>
      <p class="pipeline-stall" data-pipeline-stall<% if (!progress.stallMessage) { %> hidden<% } %>><%= progress.stallMessage || '' %></p>

      <% if (session.status === 'queued') { %>
        <p class="placeholder">Approved — waiting for the worker to pick this up. Adding another requirement above will pull this back into review.</p>
      <% } %>

      <ol class="stepper substepper" data-sub-stepper<% if (!subStepper) { %> hidden<% } %>>
        <% (subStepper || []).forEach(function(s) { %>
          <li class="step step-<%= s.state %>"><%= s.label %></li>
        <% }) %>
      </ol>

      <% if (latestRun) { %>
        <% if (latestRun.commit_sha) { %><p>Pushed commit: <code><%= latestRun.commit_sha %></code></p><% } %>
        <% if (latestRun.error_message) { %><p class="error"><%= latestRun.error_message %></p><% } %>
        <% if (latestRun.build_log) { %>
          <details><summary>Build log</summary><pre class="pipeline-log"><%= latestRun.build_log %></pre></details>
        <% } %>
        <% if (latestRun.test_log) { %>
          <details><summary>Test log</summary><pre class="pipeline-log"><%= latestRun.test_log %></pre></details>
        <% } %>
      <% } %>

      <% if (session.status === 'failed') { %>
        <p class="error">This pipeline run failed<% if (latestRun && latestRun.stage) { %> at the <%= latestRun.stage %> step<% } %>.<% if (repo.access_state === 'enabled') { %> Resume/retry the same requirements below, or clear them and start over.<% } %></p>
        <% if (repo.access_state === 'enabled') { %>
        <div class="overlap-actions">
          <% if (eligibleForResume) { %>
            <form method="POST" action="/repos/<%= repo.id %>/branches/<%= branch.id %>/resume" class="inline-form">
              <button type="submit">Resume from <%= latestRun.stage %> (attempt <%= latestRun.resume_attempt_count + 1 %>/3)</button>
            </form>
          <% } %>
          <form method="POST" action="/repos/<%= repo.id %>/branches/<%= branch.id %>/retry" class="inline-form">
            <button type="submit">Retry (full re-run)</button>
          </form>
          <form method="POST" action="/repos/<%= repo.id %>/branches/<%= branch.id %>/clear" class="inline-form">
            <button type="submit" class="danger-button">Clear &amp; start new session</button>
          </form>
        </div>
        <% } %>
      <% } %>
    <% } %>

    <%# Phase 31. Loaded only while the rendered page is queued or running -
        a poller has no reason to exist on a completed or failed page, and
        not shipping it there is a stronger stop condition than any check
        inside the script. The endpoint and the worker's own tick are handed
        over as data attributes rather than being written into the script,
        which stays a plain static file. %>
    <% if (progress.live) { %>
      <script src="/js/branch-poll.js"
        data-status-url="/repos/<%= repo.id %>/branches/<%= branch.id %>/status"
        data-poll-interval="<%= progress.pollIntervalMs %>" defer></script>
    <% } %>
  </main>
  <aside class="requirements-panel">
    <h3>Requirements Log — CO <%= branch.co_number %></h3>
    <% if (coSection) { %>
      <pre class="document-body"><%= coSection %></pre>
    <% } else { %>
      <p class="placeholder">No requirements log entries for this CO yet.</p>
    <% } %>
  </aside>
<%- include('partials/foot') %>
