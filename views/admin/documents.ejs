<%- include('../partials/head', { title: 'Admin - Documents', user: user }) %>
  <main class="content admin-content">
    <%- include('partials/nav', { active: 'documents' }) %>
    <h1>Documents</h1>
    <% if (error) { %><p class="error"><%= error %></p><% } %>

    <%# One paragraph, and it stays one however many documents exist. The prose
        about Description vs. Model prompt, about what the model reads, and
        about when a changed prompt takes effect moved to the form page in
        Phase 26 - it belongs beside the fields it describes, in front of the
        person actually typing. %>
    <p class="placeholder">
      The documents Apex writes for every repo, overnight, whenever that repo's trunk has
      moved or you have edited the prompt. Everything here is defined on this page — Apex
      ships with none, so a new install writes nothing until you create one.
    </p>

    <% if (!hasEnabledModel) { %>
      <p class="error">
        No model is enabled, so nothing can be generated no matter what is defined here.
        Add and enable one on the <a href="/admin/models">Models</a> page.
      </p>
    <% } %>

    <% if (!definitions.length) { %>
      <p class="placeholder">
        No documents are defined, so the nightly run writes nothing. To recreate the
        Spec / Communication Protocol document Apex used to ship with, see "Recreating the
        Spec / Communication Protocol document" in the README — the create form already
        opens with that document's prompt in it.
      </p>
    <% } else { %>
      <%# The model prompt is deliberately absent from this table: not
          truncated, not in a tooltip, not in a collapsed row. A list answers
          "what exists and what state is it in"; the prompt is the thing you
          open a document to read, and leaving it off is what keeps this page's
          length independent of the number of definitions. %>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Title</th><th>Key</th><th>Status</th><th>Model</th>
            <th>Repos generated</th><th></th>
          </tr>
        </thead>
        <tbody>
          <% definitions.forEach(function(d) { %>
          <tr>
            <td>
              <a href="/admin/documents/<%= d.id %>/edit"><%= d.title %></a>
              <% if (d.missingMarkdownHint) { %>
                <%# Flagged here, explained on the form. %>
                <span class="health-badge health-warning" title="This prompt never mentions Markdown">no Markdown</span>
              <% } %>
            </td>
            <td><code><%= d.docKey %></code></td>
            <td>
              <% if (d.isActive) { %>
                <span class="health-badge health-healthy">Active</span>
              <% } else { %>
                Not active
              <% } %>
            </td>
            <td>
              <% if (!d.effectiveModel) { %>
                <span class="health-badge health-locked">none available</span>
              <% } else { %>
                <%= d.effectiveModel.display_name %>
                <% if (d.usedFallback) { %>
                  <span class="health-badge health-warning" title="The model configured for this document is no longer available">fallback</span>
                <% } %>
              <% } %>
            </td>
            <td><%= d.documentCount %></td>
            <td>
              <%# The toggle stays on the row - it is the most frequent
                  operation and gates both the nightly run and on-demand branch
                  runs (Phase 25). Delete does not: it is on the edit page,
                  away from a button people press often. %>
              <form method="POST" action="/admin/documents/<%= d.id %>/active" class="row-form">
                <input type="hidden" name="active" value="<%= d.isActive ? 'false' : 'true' %>">
                <button type="submit"><%= d.isActive ? 'Turn off' : 'Turn on' %></button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>

    <p><a href="/admin/documents/new">New document</a></p>
  </main>
<%- include('../partials/foot') %>
