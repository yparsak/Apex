<%- include('partials/head', { title: repo.name + ' documents', user: user }) %>
  <aside class="sidebar">
    <%- include('partials/branch-sidebar', { repo: repo, branches: branches }) %>
  </aside>
  <main class="content">
    <p><a href="/repos/<%= repo.id %>"><%= repo.name %></a></p>
    <h1>Documents</h1>

    <h2>Requirements log</h2>
    <% if (requirementsLog) { %>
      <p class="placeholder">Last updated <%= requirementsLog.updated_at %></p>
      <pre class="document-body"><%= requirementsLog.content %></pre>
    <% } else { %>
      <p class="placeholder">No requirements have been implemented on this repo yet.</p>
    <% } %>

    <%# One block per registered document type (see ROADMAP.md Phase 23), so a
        newly registered type shows up here without a view edit. A type an admin
        has switched off still renders whatever was last generated for it:
        disabling stops regeneration, it does not delete content. %>
    <% generatedDocs.forEach(function(d) { %>
      <h2><%= d.label %></h2>
      <% if (d.doc) { %>
        <p class="placeholder">Last updated <%= d.doc.updated_at %></p>
        <pre class="document-body"><%= d.doc.content %></pre>
      <% } else { %>
        <p class="placeholder">Not generated yet — regenerates automatically once trunk has content to summarize, if this document is enabled.</p>
      <% } %>
    <% }) %>
  </main>
<%- include('partials/foot') %>
