<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %> - Apex</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="topnav">
    <div class="topnav-title">Apex</div>
    <div class="topnav-actions">
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/documents">Documents</a>
        <% if (user.isAdmin) { %><a href="/admin/orgs">Admin</a><% } %>
        <% if (managesPasswordsLocally) { %><a href="/account/password">Change Password</a><% } %>
        <span class="topnav-user"><%= user.username %></span>
        <form method="POST" action="/logout" class="inline-form">
          <button type="submit" class="link-button">Logout</button>
        </form>
      <% } else { %>
        <a href="/login">Login</a>
      <% } %>
    </div>
  </header>
  <%# appLock is set by app/middleware/appLockGate.js on every request. It is
      only ever non-null for someone the gate let through a locked app - an
      admin, or anyone on /login - so this banner is the one thing telling them
      that everyone else is currently seeing the maintenance page. %>
  <% if (typeof appLock !== 'undefined' && appLock) { %>
    <div class="app-lock-banner">
      <strong><%= appLock.reason === 'no_model' ? 'No model available' : 'Maintenance mode' %></strong>
      - <%= appLock.message %>
      <%# The fix-it links are admin-only: this banner also renders on /login,
          where the viewer is anonymous and those pages would 403. %>
      <% if (typeof user !== 'undefined' && user && user.isAdmin) { %>
        <% if (appLock.reason === 'no_model') { %>
          <a href="/admin/models">Add a model</a>
        <% } else { %>
          <a href="/admin/maintenance">Maintenance settings</a>
        <% } %>
      <% } %>
    </div>
  <% } %>
  <div class="layout">
