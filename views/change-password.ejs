<%- include('partials/head', { title: 'Change Password', user: user }) %>
  <main class="content">
    <h1>Change password</h1>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <% if (success) { %><p class="success">Password updated.</p><% } %>
    <form method="POST" action="/account/password" class="stacked-form">
      <label>Current password <input type="password" name="current_password" required></label>
      <label>New password <input type="password" name="new_password" required></label>
      <label>Confirm new password <input type="password" name="confirm_password" required></label>
      <button type="submit">Update password</button>
    </form>
  </main>
<%- include('partials/foot') %>
