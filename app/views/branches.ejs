<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Apex &mdash; Branches</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body data-repo-id="<%= repoId %>">
  <%- include('partials/header', { user }) %>
  <div class="container">
    <p><a href="/repos">&larr; Back to repositories</a></p>
    <h1 class="mb-3">Active branches</h1>

    <div class="row g-2 mb-3">
      <div class="col-md-4">
        <label for="co-input" class="form-label">Change Order number</label>
        <input type="text" id="co-input" class="form-control" placeholder="C12345678" maxlength="9">
        <div class="form-text">Format: <code>C</code> followed by 8 digits.</div>
      </div>
      <div class="col-md-2 align-self-end">
        <button id="filter-btn" type="button" class="btn btn-secondary w-100">Filter</button>
      </div>
      <div class="col-md-2 align-self-end">
        <button id="clear-filter-btn" type="button" class="btn btn-outline-secondary w-100">Show all</button>
      </div>
    </div>

    <div class="btn-group mb-3" role="group" aria-label="Ownership filter">
      <input type="radio" class="btn-check" name="owner-filter" id="owner-filter-all" value="all" checked>
      <label class="btn btn-outline-primary" for="owner-filter-all">All branches</label>
      <input type="radio" class="btn-check" name="owner-filter" id="owner-filter-mine" value="mine">
      <label class="btn btn-outline-primary" for="owner-filter-mine">Mine only</label>
    </div>

    <div id="branch-error" class="alert alert-danger d-none"></div>
    <div id="resolve-result" class="alert alert-success d-none"></div>

    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <th>Branch</th>
          <th>CO</th>
          <th>Owner</th>
          <th>My session</th>
          <th>Created</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="branch-rows">
        <tr><td colspan="6" class="text-muted">Loading&hellip;</td></tr>
      </tbody>
    </table>

    <div id="create-branch-area" class="card d-none">
      <div class="card-body">
        <h5 class="card-title">Start new work on this CO</h5>
        <p class="card-text">Creates the next available branch under your own initials
          (<code>dev/{initials}-{CO}-{n}</code>), cloned from the repo's default branch.</p>
        <button id="create-branch-btn" type="button" class="btn btn-primary">Create next branch</button>
      </div>
    </div>
  </div>
  <script src="/js/api-client.js"></script>
  <script src="/js/dom-utils.js"></script>
  <script src="/js/nav.js"></script>
  <script src="/js/branches.js"></script>
</body>
</html>
