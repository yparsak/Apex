<%- include('../partials/head', { title: 'Admin - Orgs', user: user }) %>
  <main class="content admin-content">
    <%- include('partials/nav', { active: 'orgs' }) %>
    <h1>Orgs</h1>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <table class="admin-table">
      <thead><tr><th>Name</th><th></th></tr></thead>
      <tbody>
        <% orgs.forEach(function(org) { %>
        <tr>
          <td>
            <form method="POST" action="/admin/orgs/<%= org.id %>/update" class="row-form">
              <input type="text" name="name" value="<%= org.name %>" required>
              <button type="submit">Save</button>
            </form>
          </td>
          <td>
            <form method="POST" action="/admin/orgs/<%= org.id %>/delete" class="row-form">
              <button type="submit" class="danger-button">Delete</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <h2>New org</h2>
    <form method="POST" action="/admin/orgs" class="stacked-form">
      <label>Name <input type="text" name="name" required></label>
      <button type="submit">Create</button>
    </form>
  </main>
<%- include('../partials/foot') %>
