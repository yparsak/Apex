<%
  // One template for create and edit (see ROADMAP.md Phase 26). The prose
  // beside these fields is the only place the system explains its own output
  // contract to whoever is writing a prompt, and it has to say the same thing
  // on both paths - which it does by there being one copy of it.
  var editing = !!definition;
%>
<%- include('../partials/head', { title: 'Admin - ' + (editing ? definition.title : 'New document'), user: user }) %>
  <main class="content admin-content">
    <%- include('partials/nav', { active: 'documents' }) %>
    <p><a href="/admin/documents">Documents</a></p>
    <h1><%= editing ? definition.title : 'New document' %></h1>
    <% if (error) { %><p class="error"><%= error %></p><% } %>

    <% if (editing) { %>
      <p class="placeholder">
        Key <code><%= definition.doc_key %></code> (fixed at creation — the title can
        change, this cannot).
        <% if (definition.is_active) { %>Active.<% } else { %>Not active — not regenerating.<% } %>
        Generated for <%= documentCount %> repo<%= documentCount === 1 ? '' : 's' %>.
      </p>
    <% } %>

    <p class="placeholder">
      <strong>Description</strong> is for people: it is what each repo's Documents page,
      and a branch run's report, show about why this document exists, and it is never
      sent to the model. <strong>Model prompt</strong> is sent to the model verbatim, as the system
      message, with nothing wrapped around it — what you write is exactly what it
      receives. Every document is written from the same material (the repo's file tree
      plus its README, <code>package.json</code> and <code>apex.pipeline.json</code>); you
      control what the model is told about that material, not which files it reads.
    </p>
    <p class="placeholder">
      Each document is given its own model here — these jobs run unattended with no user
      behind them to inherit a model choice from. Turning one off stops it being
      regenerated; it deletes nothing, and what has already been written stays readable on
      each repo's Documents page, frozen at the last version generated.
    </p>

    <% if (!enabledModels.length) { %>
      <p class="error">
        No model is enabled, so nothing can be generated no matter what you save here.
        Add and enable one on the <a href="/admin/models">Models</a> page.
      </p>
    <% } %>

    <% if (editing && !effectiveModel) { %>
      <p class="error">No model available — this document cannot be generated.</p>
    <% } else if (editing && usedFallback) { %>
      <p class="error">
        The model configured for this document is no longer available (disabled or
        deleted), so the catalog default (<%= effectiveModel.display_name %>) is being
        used instead. Pick a model below to make the choice explicit again.
      </p>
    <% } %>

    <% if (missingMarkdownHint) { %>
      <p class="placeholder">
        This prompt never mentions Markdown. Generated documents are rendered as
        Markdown, so a prompt that doesn't ask for it may produce something that reads
        like a chat reply. Advisory only — saved as written.
      </p>
    <% } %>

    <% if (!editing) { %>
      <%# Prefilled, not blank. The starter is the prompt that used to be the
          hardcoded spec doc, and it exists to teach the output contract: there
          is no way to validate that a prompt will produce Markdown, so the
          defense is that the admin starts from something that already does. %>
      <p class="placeholder">
        The prompt below is a working example — the one Apex used to ship with. Edit it
        rather than starting from nothing, and keep a line like its last one: it is what
        makes the model return a document instead of a reply.
      </p>
    <% } %>

    <form method="POST"
          action="<%= editing ? '/admin/documents/' + definition.id + '/update' : '/admin/documents' %>"
          class="stacked-form instructions-form">
      <label>Title
        <input type="text" name="title" value="<%= form.title %>"
               maxlength="<%= maxTitleLength %>" placeholder="e.g. Code Review Notes" required>
      </label>
      <label>Description (shown to people, never sent to the model)
        <textarea name="description" rows="2" placeholder="What is this document for?"><%= form.description %></textarea>
      </label>
      <%# Editing this bumps prompt_revision, which is what makes every repo's
          copy regenerate on the next nightly run. Editing the title or the
          description does not - neither reaches the model. %>
      <label>Model prompt (sent to the model verbatim, at least <%= minPromptLength %> characters)
        <textarea name="model_prompt" rows="16" required><%= form.model_prompt %></textarea>
      </label>
      <label>Model
        <select name="model_id">
          <option value="" <%= form.model_id ? '' : 'selected' %>>
            Use the catalog default<%= editing && effectiveModel && !definition.model_id ? ' (' + effectiveModel.display_name + ')' : '' %>
          </option>
          <% enabledModels.forEach(function(m) { %>
            <option value="<%= m.id %>" <%= String(form.model_id) === String(m.id) ? 'selected' : '' %>><%= m.display_name %></option>
          <% }) %>
        </select>
      </label>
      <% if (!editing) { %>
        <%# Checked by default: someone who just wrote a prompt wants it to run.
            An unchecked box posts nothing at all, which the route reads as
            "created but not active". Absent on the edit form - there the
            on/off switch is on the list, one click from the row. %>
        <label class="checkbox-label">
          <input type="checkbox" name="is_active" value="1" <%= form.is_active ? 'checked' : '' %>>
          Generate this document from the next nightly run
        </label>
      <% } %>
      <button type="submit"><%= editing ? 'Save' : 'Create document' %></button>
      <% if (editing) { %>
        <p class="placeholder">
          Saving a changed prompt regenerates this document for every repo on the next
          nightly run — not immediately.
        </p>
      <% } %>
    </form>

    <% if (editing) { %>
      <h2>Delete</h2>
      <%# Archives rather than purges, so the confirm says what actually
          happens: the already-generated copies survive, they just stop being
          listed anywhere. The title is deliberately not interpolated into the
          confirm text - it is admin-supplied and would be going into a JS
          string literal inside an HTML attribute, which is two layers of
          escaping to get right for no gain. %>
      <form method="POST" action="/admin/documents/<%= definition.id %>/delete" class="row-form"
            onsubmit="return confirm('Delete this document? It stops being generated and disappears from every repo Documents page. The <%= documentCount %> already written are not deleted, but nothing will list them. This cannot be undone from here.');">
        <button type="submit" class="danger-button">Delete this document</button>
      </form>
    <% } %>
  </main>
<%- include('../partials/foot') %>
