<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Apex &mdash; Session</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body data-repo-id="<%= repoId %>" data-branch-id="<%= branchId %>">
  <%- include('partials/header', { user }) %>
  <div class="container">
    <p><a href="/repos/<%= repoId %>/branches">&larr; Back to branches</a></p>
    <h1 class="mb-3">Clarification session</h1>

    <div id="session-error" class="alert alert-danger d-none"></div>
    <div id="session-status-banner" class="alert d-none"></div>

    <div class="row g-3">
      <div class="col-lg-8">
        <div class="card mb-3">
          <div class="card-header">Transcript</div>
          <div id="transcript" class="card-body" style="max-height: 50vh; overflow-y: auto;">
            <p class="text-muted">Loading&hellip;</p>
          </div>
          <div class="card-footer">
            <div class="input-group">
              <textarea id="message-input" class="form-control" rows="2"
                placeholder="Describe what you need, or answer the agent's question&hellip;"></textarea>
              <button id="send-btn" type="button" class="btn btn-primary">Send</button>
            </div>
          </div>
        </div>

        <div id="requirements-panel" class="card mb-3 d-none">
          <div class="card-header">Requirements needing your confirmation</div>
          <ul id="pending-requirements" class="list-group list-group-flush"></ul>
        </div>

        <div id="finalized-panel" class="card mb-3 d-none">
          <div class="card-header">Resolved requirements for this session</div>
          <ul id="finalized-requirements" class="list-group list-group-flush"></ul>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card">
          <div class="card-header">Other sessions on this branch</div>
          <ul id="other-sessions" class="list-group list-group-flush">
            <li class="list-group-item text-muted">Loading&hellip;</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
  <script src="/js/api-client.js"></script>
  <script src="/js/dom-utils.js"></script>
  <script src="/js/nav.js"></script>
  <script src="/js/session.js"></script>
</body>
</html>
