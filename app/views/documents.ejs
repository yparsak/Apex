<%- include('partials/head', { title: 'Documents', user: user }) %>
  <aside class="sidebar"></aside>
  <main class="content">
    <h1>Documents</h1>
    <p class="placeholder">Search every repo you can access for a CO's requirements log entry.</p>

    <form method="GET" action="/documents" class="stacked-form">
      <label>CO number
        <input type="text" name="co_number" value="<%= coNumber %>" placeholder="C12345678" pattern="C[0-9]{8}">
      </label>
      <button type="submit">Search</button>
    </form>

    <% if (error) { %><p class="error"><%= error %></p><% } %>

    <% if (coNumber && !error) { %>
      <h2>Results for <%= coNumber %></h2>
      <% if (!results.length) { %>
        <p class="placeholder">No requirements log entries for this CO in any repo you can access.</p>
      <% } else { %>
        <% results.forEach(function(r) { %>
          <div class="document-result">
            <h3><a href="/repos/<%= r.repo.id %>/documents"><%= r.repo.org_name %> / <%= r.repo.repo_group_name %> / <%= r.repo.name %></a></h3>
            <%# A hit from a dormant repo is exactly the case where the reader
                has no other cue - they did not navigate through that repo's
                pages to get here, so the banner those carry never reached them
                (see ROADMAP.md Phase 27). %>
            <% if (r.repo.access_state === 'disabled') { %>
              <p class="placeholder">
                <span class="health-badge health-warning">Repo disabled</span>
                nothing new is generated or recorded here<% if (r.repo.access_state_note) { %> &mdash; <%= r.repo.access_state_note %><% } %>
              </p>
            <% } else if (r.repo.access_state === 'read_only') { %>
              <p class="placeholder">
                <span class="health-badge health-warning">Repo read-only</span>
                documents still update, but no new work is being started here<% if (r.repo.access_state_note) { %> &mdash; <%= r.repo.access_state_note %><% } %>
              </p>
            <% } %>
            <pre class="document-body"><%= r.body %></pre>
          </div>
        <% }) %>
      <% } %>
    <% } %>
  </main>
<%- include('partials/foot') %>
