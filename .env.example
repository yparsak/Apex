DB_HOST=apex-mariadb
DB_PORT=3306
DB_NAME=apex
DB_USER=apex
DB_PASSWORD=apex_dev_password
DB_ROOT_PASSWORD=apex_dev_root_password
SESSION_SECRET=change_me_dev_only
PORT=3000

# Phase 11: when set, admin-created users get this password instead of the
# admin entering one on the create-user form (see ROADMAP.md Phase 11).
# Leave blank to keep the admin-enters-a-password behavior unchanged.
DEFAULT_USER_PASSWORD=

# Phase 17: selects the auth provider module (app/lib/auth/authProvider.js).
# Only `local` exists today. A future SSO provider (LDAP, Azure AD, etc.)
# registers under its own value here and sets managesPasswordsLocally=false,
# which hides the admin create-user password field and the self-service
# password-change page. Defaults to `local` when unset.
AUTH_PROVIDER=local

GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# Provider endpoint credentials only. Which model(s) to call is NOT configured
# here any more: MODEL and MODEL_MAX_TOKENS were removed in Phase 22 and are
# now rows in the `models` table, managed by an admin at /admin/models, so a
# deployment can offer several models and users can pick between them.
#
# The table ships empty and there is no fallback to this file, so a fresh
# install has no usable model and locks itself with a "No model available"
# message until an admin adds one. That is deliberate - see db/schema.sql.
#
# (Known provider quirk worth recording somewhere: moonshotai/kimi-k3
# sometimes responds with !!!!!!!!!!!!!!!!!)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=

# Phase 7: sandboxed execution (worker.js). SANDBOX_NETWORK must be a network
# the host's Docker daemon already has (the `apex-net` created by `make
# network` works, and has real internet egress) - sandbox containers are
# attached to it for clone/codegen, then disconnected before build/test.
SANDBOX_RUNTIME=docker
SANDBOX_NETWORK=apex-net
PIPELINE_POLL_INTERVAL_MS=5000
PIPELINE_STEP_TIMEOUT_MS=600000


# Phase 12: structured app logs are rotated into logs/ (see ROADMAP.md Phase
# 12) on top of Docker's own --log-opt count-based rotation. This governs a
# separate purge sweep over those rotated files - anything older than this
# many days is deleted. Defaults to 3 when unset.
LOG_RETENTION_DAYS=3

# Phase 12: pino level (trace/debug/info/warn/error/fatal) applied to both the
# stdout and logs/<name>.log targets. Defaults to info when unset.
LOG_LEVEL=info
